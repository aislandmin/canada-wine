# systemd service: keeps the website running and restarts it after a crash or reboot.
# Install:  cp /opt/canada-wine/deploy/canada-wine.service /etc/systemd/system/
#           systemctl daemon-reload && systemctl enable --now canada-wine
[Unit]
Description=Canada wine website
After=network.target

[Service]
User=wine
WorkingDirectory=/opt/canada-wine
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=DATA_DIR=/opt/canada-wine/data
Environment=TRUST_PROXY=1
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
