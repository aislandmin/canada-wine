{
  "name": "canada-wine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --import tsx --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx --disable-warning=ExperimentalWarning server/index.ts",
    "test": "vitest run",
    "demo:add": "node --import tsx --disable-warning=ExperimentalWarning server/scripts/demo.ts add",
    "demo:remove": "node --import tsx --disable-warning=ExperimentalWarning server/scripts/demo.ts remove",
    "create-admin": "node --import tsx --disable-warning=ExperimentalWarning server/scripts/create-admin.ts",
    "admins": "node --import tsx --disable-warning=ExperimentalWarning server/scripts/admins.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.13"
  }
}
